# apps/api — never commit real values. Copy to apps/api/.env for local use.
PORT=8787
# Comma-separated web origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173
# Neon: pooled URL for the app, direct (unpooled) URL for migrations (pnpm --filter @littleboss/api db:migrate)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: a local throwaway Postgres for the database tests (they are skipped when unset)
TEST_DATABASE_URL=
# Model API keys live ONLY on the backend. Never expose them to apps/web (no VITE_ prefix).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Try the app with NO keys and no cost: every AI answers with a clearly-labelled demo reply.
# Local only; never set this on the production deployment.
LB_FAKE_PROVIDERS=
# Shared access password for the web app. Leave empty locally (no login); required in production.
ACCESS_TOKEN=
# Used to encrypt stored per-user API keys (32+ random bytes, base64). Generate locally.
ENCRYPTION_KEY=

# apps/web — public values only (these ship to the browser)
VITE_API_URL=http://localhost:8787
